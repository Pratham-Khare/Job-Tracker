PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/job_tracker
JWT_SECRET=replace_with_a_long_random_secret
TOKEN_ENCRYPTION_KEY=replace_with_another_long_random_secret
CLIENT_URL=http://localhost:5173

# Gmail OAuth - create a Web application OAuth client in Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

SERVER_PUBLIC_URL=http://localhost:5000
FOLLOWUP_CHECK_CRON=*/30 * * * *
GMAIL_REPLY_CHECK_CRON=*/2 * * * *
SEND_REMINDER_EMAILS=false
